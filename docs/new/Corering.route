/**
 * POST /api/corering
 * ─────────────────────────────────────────────────────────────────
 * CoreRing 통합 라우트.
 * action 필드로 번역·방언·충돌·파이프라인·로그·사전 전체 처리.
 *
 * ■ 통폐합 대상 (기존 → 이 라우트)
 *   /api/corering?action=translate      ← handleTranslate
 *   /api/corering?action=get-conflicts  ← handleGetConflicts
 *   /api/corering?action=get-dictionary ← handleGetDictionary
 *   /api/corering?action=pipeline       ← handlePipeline
 *   /api/corering?action=corelink       ← handleCorelink
 *
 * ■ Vercel Hobby 12개 한도
 *   이 라우트는 1개만 소비한다.
 *
 * ─── 계약 (Master v1.0 §4) ───────────────────────────────────────
 * - req.text() + JSON.parse() (req.json() 금지)
 * - throw 금지 → _error 반환
 * - traceId 전 구간 포함
 * ─────────────────────────────────────────────────────────────────
 *
 * 요청:
 * POST /api/corering
 * { "action": "translate" | "get-conflicts" | "get-dictionary"
 *            | "pipeline"  | "corelink",
 *   "payload": { ... },
 *   "traceId": "uuid"   // 선택
 * }
 */

import { createClient }    from '@supabase/supabase-js';
import { CoreRingLayer }   from '../../../brain-engine/layers/CoreRingLayer.js';

const sb = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL,
  process.env.SUPABASE_SERVICE_ROLE_KEY,
);
const ring = new CoreRingLayer();

const ALLOWED = new Set([
  'translate', 'get-conflicts', 'get-dictionary', 'pipeline', 'corelink',
]);

export async function POST(req) {
  const traceId = crypto.randomUUID();

  let body;
  try {
    body = JSON.parse(await req.text());
  } catch {
    return _res({ _error: { code: 'PARSE_FAIL', message: '요청 파싱 실패', retryable: false } }, traceId, 400);
  }

  const { action, payload = {}, traceId: cTid } = body;
  const tid = cTid || traceId;

  if (!ALLOWED.has(action)) {
    return _res({ _error: { code: 'UNKNOWN_ACTION', message: `알 수 없는 action: ${action}`, retryable: false } }, tid);
  }

  const ctx = { payload, traceId: tid, _error: null };

  try {
    let result;
    switch (action) {

      // ── 번역 ────────────────────────────────────────────────────
      case 'translate': {
        const { text, target, userLocale } = payload;
        if (!text || !target) {
          return _res({ _error: { code: 'MISSING_PARAMS', message: 'text, target 필수', retryable: false } }, tid);
        }
        result = await ring.translate(ctx);
        break;
      }

      // ── 충돌 사전 로드 ───────────────────────────────────────────
      case 'get-conflicts': {
        const { data, error } = await sb.from('tp_conflicts').select('*');
        if (error) return _res({ _error: { code: 'DB_FAIL', message: error.message, retryable: true } }, tid);
        result = { ...ctx, payload: { conflicts: data ?? [] } };
        break;
      }

      // ── 단어 사전 로드 ───────────────────────────────────────────
      case 'get-dictionary': {
        const { data, error } = await sb.from('tp_translations').select('*');
        if (error) return _res({ _error: { code: 'DB_FAIL', message: error.message, retryable: true } }, tid);
        result = { ...ctx, payload: { dictionary: data ?? [] } };
        break;
      }

      // ── 데이터셋 파이프라인 ──────────────────────────────────────
      case 'pipeline': {
        const { inputText, outputText, isKorean } = payload;
        if (!inputText || !outputText) {
          return _res({ _error: { code: 'MISSING_PARAMS', message: 'inputText, outputText 필수', retryable: false } }, tid);
        }
        const { error } = await sb.from('tp_translations').insert({
          source_text: isKorean ? inputText : outputText,
          target_text: isKorean ? outputText : inputText,
          direction:   isKorean ? 'KO_VI' : 'VI_KO',
          created_at:  new Date().toISOString(),
        });
        if (error) return _res({ _error: { code: 'DB_FAIL', message: error.message, retryable: true } }, tid);
        result = { ...ctx, payload: { saved: true } };
        break;
      }

      // ── 번역 상세 로그 저장 (CoreLink) ──────────────────────────
      case 'corelink': {
        const {
          inputText, outputText, direction,
          detectedDialect, finalDialect,
          emotionScore, riskScore,
          sessionId, conflictCount,
          intent, intentConf,
        } = payload;

        const { error } = await sb.from('tb_trans_logs').insert({
          input_text:       inputText,
          output_text:      outputText,
          direction,
          detected_dialect: detectedDialect,
          final_dialect:    finalDialect,
          emotion_score:    emotionScore,
          risk_score:       riskScore,
          session_id:       sessionId,
          conflict_count:   conflictCount,
          intent,
          intent_conf:      intentConf,
          trace_id:         tid,
          created_at:       new Date().toISOString(),
        });
        if (error) return _res({ _error: { code: 'DB_FAIL', message: error.message, retryable: true } }, tid);
        result = { ...ctx, payload: { logged: true } };
        break;
      }
    }

    return _res(result, tid);

  } catch (e) {
    return _res({ _error: { code: 'LAYER_FAIL', message: e.message, retryable: true } }, tid, 500);
  }
}

function _res(data, traceId, status = 200) {
  return new Response(
    JSON.stringify({ ...data, traceId }),
    { status, headers: { 'Content-Type': 'application/json; charset=utf-8' } }
  );
}