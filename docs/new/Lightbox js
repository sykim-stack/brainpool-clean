/**
 * MODULE-CN-18: 라이트박스 (Lightbox)
 * 소속: CoreNull / ui
 * 역할: 이미지 슬라이드 뷰어 (터치 스와이프, 키보드, 썸네일)
 *
 * ─── 계약 (Master v1.0 §4) ───────────────────────────────────────
 * - 이 모듈은 UI 렌더링만 담당. 비즈니스 로직 없음.
 * - state 변경 없음. 외부 state.lbImages / state.lbIndex 는 읽기 전용.
 * - throw 금지. 오류는 console.warn 으로만 처리.
 * ─────────────────────────────────────────────────────────────────
 *
 * 사용법:
 *   import { openLightbox, closeLightbox } from './ui/lightbox.js';
 *   openLightbox(['https://...img1', 'https://...img2'], 0);
 */

'use strict';

// ── 내부 상태 (모듈 스코프 한정 — 전역 ctx 참조 금지) ──────────────
let _images = [];
let _index  = 0;

// ── DOM 참조 (지연 초기화) ──────────────────────────────────────────
let _overlay = null;
let _img     = null;
let _counter = null;
let _thumbs  = null;

// 터치 추적
let _touchStartX = 0;

// ── 초기화 ─────────────────────────────────────────────────────────
function _ensureDOM() {
  if (_overlay) return;

  _overlay = document.getElementById('lightbox');

  if (!_overlay) {
    console.warn('[Lightbox] #lightbox 요소를 찾을 수 없습니다. _buildDOM()으로 생성합니다.');
    _buildDOM();
    return;
  }

  _img     = _overlay.querySelector('#lb-img');
  _counter = _overlay.querySelector('#lb-counter');
  _thumbs  = _overlay.querySelector('#lb-thumbs');
}

/**
 * house.html 에 #lightbox 가 없을 때 동적으로 생성.
 * house.html 에 마크업이 있으면 이 함수는 호출되지 않음.
 */
function _buildDOM() {
  _overlay = document.createElement('div');
  _overlay.id = 'lightbox';
  _overlay.setAttribute('role', 'dialog');
  _overlay.setAttribute('aria-modal', 'true');
  _overlay.setAttribute('aria-label', '이미지 뷰어');
  _overlay.style.cssText = [
    'display:none',
    'position:fixed',
    'inset:0',
    'background:rgba(0,0,0,0.92)',
    'z-index:9999',
    'flex-direction:column',
    'align-items:center',
    'justify-content:center',
  ].join(';');

  _overlay.innerHTML = `
    <button id="lb-close" aria-label="닫기"
      style="position:absolute;top:16px;right:20px;background:none;border:none;
             color:#fff;font-size:28px;cursor:pointer;line-height:1;">×</button>

    <button id="lb-prev" aria-label="이전 이미지"
      style="position:absolute;left:12px;top:50%;transform:translateY(-50%);
             background:rgba(255,255,255,0.15);border:none;color:#fff;
             font-size:24px;padding:12px 16px;border-radius:8px;cursor:pointer;">‹</button>

    <img id="lb-img" alt="이미지 뷰어"
      style="max-width:90vw;max-height:80vh;object-fit:contain;border-radius:4px;
             user-select:none;-webkit-user-drag:none;" />

    <button id="lb-next" aria-label="다음 이미지"
      style="position:absolute;right:12px;top:50%;transform:translateY(-50%);
             background:rgba(255,255,255,0.15);border:none;color:#fff;
             font-size:24px;padding:12px 16px;border-radius:8px;cursor:pointer;">›</button>

    <div id="lb-counter"
      style="color:rgba(255,255,255,0.7);font-size:14px;margin-top:12px;"></div>

    <div id="lb-thumbs"
      style="display:flex;gap:8px;margin-top:12px;overflow-x:auto;
             max-width:90vw;padding-bottom:4px;"></div>
  `;

  document.body.appendChild(_overlay);

  _img     = _overlay.querySelector('#lb-img');
  _counter = _overlay.querySelector('#lb-counter');
  _thumbs  = _overlay.querySelector('#lb-thumbs');

  // ── 이벤트 바인딩 ────────────────────────────────────────────────
  _overlay.querySelector('#lb-close').addEventListener('click', closeLightbox);
  _overlay.querySelector('#lb-prev').addEventListener('click', lbPrev);
  _overlay.querySelector('#lb-next').addEventListener('click', lbNext);

  // 오버레이 바깥 클릭 → 닫기
  _overlay.addEventListener('click', (e) => {
    if (e.target === _overlay) closeLightbox();
  });

  // 터치 스와이프
  _overlay.addEventListener('touchstart', (e) => {
    _touchStartX = e.touches[0].clientX;
  }, { passive: true });

  _overlay.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - _touchStartX;
    if (Math.abs(dx) > 50) dx < 0 ? lbNext() : lbPrev();
  });
}

// ── 렌더링 ─────────────────────────────────────────────────────────
function _render() {
  if (!_images.length) return;

  _img.src = _images[_index];
  _img.alt = `이미지 ${_index + 1} / ${_images.length}`;
  _counter.textContent = `${_index + 1} / ${_images.length}`;

  // 썸네일
  _thumbs.innerHTML = '';
  if (_images.length > 1) {
    _images.forEach((url, i) => {
      const t = document.createElement('img');
      t.src = url;
      t.alt = `썸네일 ${i + 1}`;
      t.style.cssText = [
        'width:56px',
        'height:56px',
        'object-fit:cover',
        'border-radius:4px',
        'cursor:pointer',
        `opacity:${i === _index ? '1' : '0.5'}`,
        `border:2px solid ${i === _index ? '#fff' : 'transparent'}`,
        'transition:opacity 0.2s,border-color 0.2s',
        'flex-shrink:0',
      ].join(';');
      t.addEventListener('click', () => lbGoTo(i));
      _thumbs.appendChild(t);
    });
  }
}

// ── 공개 API ────────────────────────────────────────────────────────

/**
 * 라이트박스를 열고 지정 인덱스 이미지를 표시합니다.
 * @param {string[]} urls     이미지 URL 배열
 * @param {number}  [startIdx=0]  표시할 시작 인덱스
 */
export function openLightbox(urls, startIdx = 0) {
  if (!Array.isArray(urls) || !urls.length) {
    console.warn('[Lightbox] 유효한 이미지 URL 배열이 필요합니다.');
    return;
  }

  _ensureDOM();
  _images = urls;
  _index  = Math.max(0, Math.min(startIdx, urls.length - 1));

  _overlay.style.display = 'flex';
  document.body.style.overflow = 'hidden';
  _render();

  // 포커스 트랩
  _overlay.querySelector('#lb-close')?.focus();
}

/**
 * 지정 인덱스로 이동합니다.
 * @param {number} i  이동할 인덱스
 */
export function lbGoTo(i) {
  if (!_images.length) return;
  _index = ((i % _images.length) + _images.length) % _images.length;
  _render();
}

/** 이전 이미지로 이동합니다. */
export function lbPrev() {
  lbGoTo(_index - 1);
}

/** 다음 이미지로 이동합니다. */
export function lbNext() {
  lbGoTo(_index + 1);
}

/** 라이트박스를 닫습니다. */
export function closeLightbox() {
  if (!_overlay) return;
  _overlay.style.display = 'none';
  document.body.style.overflow = '';
  _images = [];
  _index  = 0;
}

// ── 키보드 단축키 (전역 1회 등록) ──────────────────────────────────
document.addEventListener('keydown', (e) => {
  if (!_overlay || _overlay.style.display === 'none') return;
  if (e.key === 'ArrowLeft')  lbPrev();
  if (e.key === 'ArrowRight') lbNext();
  if (e.key === 'Escape')     closeLightbox();
});