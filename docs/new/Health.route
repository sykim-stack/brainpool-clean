/**
 * GET /api/debug/health
 * ─────────────────────────────────────────────────────────────────
 * 시스템 헬스체크 라우트.
 * - API 라우트 수 확인
 * - Supabase 연결 상태 확인
 * - 환경 변수 필수 키 존재 확인
 * ─────────────────────────────────────────────────────────────────
 */

import { createClient } from '@supabase/supabase-js';

const REQUIRED_ENV = [
  'NEXT_PUBLIC_SUPABASE_URL',
  'SUPABASE_SERVICE_ROLE_KEY',
  'DEEPL_API_KEY',
  'CLOUDINARY_CLOUD_NAME',
  'CLOUDINARY_API_KEY',
  'CLOUDINARY_API_SECRET',
];

// 현재 등록된 API 라우트 목록 (수동 관리 — 추가 시 여기도 업데이트)
const REGISTERED_ROUTES = [
  'POST /api/brainpool',    // CoreRing 엔진
  'POST /api/corering',     // CoreRing 통합 (번역·방언·충돌·사전·파이프라인)
  'POST /api/corechat',     // CoreChat 통합 (방·메시지·폴링)
  'POST /api/messages',     // Message 단일 구조 CRUD
  'POST /api/corenull',     // CoreNull 통합 (house·카테고리·업로드·온보딩·로케일)
  'POST /api/gemini',       // Gemini AI (caption·emotion·story·translate)
  'GET  /api/debug/health', // 헬스체크 (이 파일)
];

const VERCEL_HOBBY_LIMIT = 12;

export async function GET() {
  const traceId = crypto.randomUUID();
  const checks  = {};

  // ── 환경 변수 점검 ──────────────────────────────────────────────
  const envStatus = {};
  for (const key of REQUIRED_ENV) {
    envStatus[key] = process.env[key] ? '✅' : '❌ MISSING';
  }
  checks.env = envStatus;

  // ── Supabase 연결 점검 ──────────────────────────────────────────
  try {
    const sb = createClient(
      process.env.NEXT_PUBLIC_SUPABASE_URL,
      process.env.SUPABASE_SERVICE_ROLE_KEY,
    );
    const { error } = await sb.from('messages').select('id').limit(1);
    checks.supabase = error ? `❌ ${error.message}` : '✅ connected';
  } catch (e) {
    checks.supabase = `❌ ${e.message}`;
  }

  // ── API 라우트 한도 점검 ────────────────────────────────────────
  const routeCount = REGISTERED_ROUTES.length;
  checks.routes = {
    count:     routeCount,
    limit:     VERCEL_HOBBY_LIMIT,
    remaining: VERCEL_HOBBY_LIMIT - routeCount,
    status:    routeCount <= VERCEL_HOBBY_LIMIT ? '✅ 한도 내' : `❌ 초과 (${routeCount - VERCEL_HOBBY_LIMIT}개 초과)`,
    list:      REGISTERED_ROUTES,
  };

  const allOk = Object.values(envStatus).every(v => v === '✅')
    && checks.supabase === '✅ connected'
    && routeCount <= VERCEL_HOBBY_LIMIT;

  return new Response(
    JSON.stringify({
      status:  allOk ? 'OK' : 'DEGRADED',
      traceId,
      checks,
      ts: new Date().toISOString(),
    }),
    {
      status: 200,
      headers: { 'Content-Type': 'application/json; charset=utf-8' },
    }
  );
}