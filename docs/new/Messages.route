/**
 * POST /api/messages
 * ─────────────────────────────────────────────────────────────────
 * Message 단일 구조 통합 API.
 * action 필드로 CRUD + react 를 하나의 라우트에서 처리.
 *
 * ⚠️ Vercel Hobby 12개 API 한도 대응:
 *    기존 /api/posts, /api/comment, /api/chat/send 를
 *    이 단일 라우트로 통합한다.
 *    (기존 라우트는 deprecated 후 6주 뒤 삭제)
 *
 * ─── 계약 (Master v1.0 §4) ───────────────────────────────────────
 * - req.text() + JSON.parse() 필수 (req.json() 금지)
 * - 응답: 200 (내부 _error 포함) | 500 (라우트 자체 오류)
 * - traceId 전 구간 포함
 * - Content-Type: application/json; charset=utf-8
 * ─────────────────────────────────────────────────────────────────
 *
 * 요청 형식:
 * POST /api/messages
 * {
 *   "action":  "create" | "get" | "list" | "update" | "delete" | "react",
 *   "payload": { ... },    // action별 상이
 *   "traceId": "uuid"      // 선택 (없으면 자동 생성)
 * }
 */

import { createClient } from '@supabase/supabase-js';
import { messageLayer }  from '../../../brain-engine/layers/MessageLayer.js';

// ── Supabase 초기화 (서버 전용) ─────────────────────────────────────
const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL,
  process.env.SUPABASE_SERVICE_ROLE_KEY,
);

// 전역 supabase 참조 주입 (MessageLayer가 _getSupabase()로 접근)
if (typeof globalThis !== 'undefined') {
  globalThis.__supabase = supabase;
}

// ── 허용된 action 목록 ──────────────────────────────────────────────
const ALLOWED_ACTIONS = new Set(['create', 'get', 'list', 'update', 'delete', 'react']);

// ── 라우트 핸들러 ───────────────────────────────────────────────────
export async function POST(req) {
  const traceId = crypto.randomUUID();

  let body;
  try {
    // ✅ req.text() + JSON.parse() (req.json() 금지 — Master v1.0 V1)
    const raw = await req.text();
    body = JSON.parse(raw);
  } catch {
    return _res({ _error: { code: 'PARSE_FAIL', message: '요청 본문 파싱 실패', retryable: false } }, traceId, 400);
  }

  const { action, payload = {}, traceId: clientTraceId } = body;
  const tid = clientTraceId || traceId;

  if (!ALLOWED_ACTIONS.has(action)) {
    return _res({
      _error: { code: 'UNKNOWN_ACTION', message: `알 수 없는 action: ${action}`, retryable: false },
    }, tid);
  }

  // ctx 구성
  const ctx = { payload, traceId: tid, _error: null };

  // action 라우팅
  let result;
  try {
    result = await messageLayer[action](ctx);
  } catch (e) {
    return _res({ _error: { code: 'LAYER_FAIL', message: e.message, retryable: true } }, tid, 500);
  }

  return _res(result, tid);
}

// ── 응답 헬퍼 ──────────────────────────────────────────────────────
function _res(data, traceId, status = 200) {
  return new Response(
    JSON.stringify({ ...data, traceId }),
    {
      status,
      headers: { 'Content-Type': 'application/json; charset=utf-8' },
    }
  );
}