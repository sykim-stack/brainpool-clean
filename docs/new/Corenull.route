/**
 * POST /api/corenull
 * ─────────────────────────────────────────────────────────────────
 * CoreNull 통합 라우트.
 * House CRUD, 카테고리, 공유, 업로드, 온보딩, 로케일을 단일 라우트로.
 *
 * ■ 통폐합 대상 (Vercel Hobby 12개 한도 확보)
 *   /api/house         → action: get-house, update-house, create-story, ...
 *   /api/categories    → action: create-cat, update-cat, delete-cat
 *   /api/share         → action: create-invite
 *   /api/upload        → action: sign-upload  (Cloudinary 서명)
 *   /api/locale        → action: get-locale, set-locale
 *   /api/onboarding    → action: get-interests, set-interests, join-house
 *
 * ■ 별도 유지 라우트 (통폐합 제외)
 *   /api/messages      → Message CRUD (②번 작업에서 생성)
 *   /api/corering      → CoreRing 번역/분석
 *   /api/corechat      → CoreChat 채팅방/메시지
 *   /api/gemini        → Gemini AI (토큰 크기 이유로 분리 유지)
 *   /api/brainpool     → CoreRing 엔진 진입점
 *   /api/debug/health  → 헬스체크
 *
 * ─── 계약 (Master v1.0 §4) ───────────────────────────────────────
 * - req.text() + JSON.parse()
 * - throw 금지 → _error 반환
 * - traceId 전 구간 포함
 * ─────────────────────────────────────────────────────────────────
 */

import { createClient } from '@supabase/supabase-js';
import { v2 as cloudinary } from 'cloudinary';

const sb = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL,
  process.env.SUPABASE_SERVICE_ROLE_KEY,
);

cloudinary.config({
  cloud_name: process.env.CLOUDINARY_CLOUD_NAME,
  api_key:    process.env.CLOUDINARY_API_KEY,
  api_secret: process.env.CLOUDINARY_API_SECRET,
});

const ALLOWED = new Set([
  // house
  'get-house', 'update-house',
  'create-story', 'update-story', 'delete-story',
  // categories
  'create-cat', 'update-cat', 'delete-cat',
  // share
  'create-invite',
  // upload
  'sign-upload',
  // locale
  'get-locale', 'set-locale',
  // onboarding
  'get-interests', 'set-interests', 'join-house',
]);

export async function POST(req) {
  const traceId = crypto.randomUUID();

  let body;
  try {
    body = JSON.parse(await req.text());
  } catch {
    return _res({ _error: { code: 'PARSE_FAIL', message: '요청 파싱 실패', retryable: false } }, traceId, 400);
  }

  const { action, payload = {}, traceId: cTid } = body;
  const tid = cTid || traceId;

  if (!ALLOWED.has(action)) {
    return _res({ _error: { code: 'UNKNOWN_ACTION', message: `알 수 없는 action: ${action}`, retryable: false } }, tid);
  }

  try {
    let result;

    switch (action) {

      // ════════════════════════════════════════════════════════════
      // HOUSE
      // ════════════════════════════════════════════════════════════

      case 'get-house': {
        const { slug, owner_key } = payload;
        if (!slug) return _err(tid, 'MISSING_PARAMS', 'slug 필수');

        let q = sb.from('corenull_houses').select(`
          *,
          rooms:corenull_rooms(*),
          milestones:corenull_milestones(*),
          categories:categories(*)
        `).eq('slug', slug);

        if (owner_key) q = q.eq('owner_key', owner_key);

        const { data, error } = await q.single();
        if (error || !data) return _err(tid, 'NOT_FOUND', '하우스를 찾을 수 없습니다');
        result = { house: data };
        break;
      }

      case 'update-house': {
        const { id, owner_key, ...patch } = payload;
        if (!id || !owner_key) return _err(tid, 'MISSING_PARAMS', 'id, owner_key 필수');

        const { data, error } = await sb.from('corenull_houses')
          .update(patch).eq('id', id).eq('owner_key', owner_key)
          .select().single();
        if (error) return _err(tid, 'DB_FAIL', error.message);
        result = { house: data };
        break;
      }

      case 'create-story': {
        const { house_id, owner_key, category_id, content, cover_url } = payload;
        if (!house_id || !owner_key) return _err(tid, 'MISSING_PARAMS', 'house_id, owner_key 필수');

        const { data, error } = await sb.from('corenull_stories').insert({
          house_id, category_id, content, cover_url,
          created_at: new Date().toISOString(),
        }).select().single();
        if (error) return _err(tid, 'DB_FAIL', error.message);
        result = { story: data };
        break;
      }

      case 'update-story': {
        const { story_id, owner_key, content, cover_url } = payload;
        if (!story_id) return _err(tid, 'MISSING_PARAMS', 'story_id 필수');

        const { data, error } = await sb.from('corenull_stories')
          .update({ content, cover_url }).eq('id', story_id)
          .select().single();
        if (error) return _err(tid, 'DB_FAIL', error.message);
        result = { story: data };
        break;
      }

      case 'delete-story': {
        const { story_id } = payload;
        if (!story_id) return _err(tid, 'MISSING_PARAMS', 'story_id 필수');

        const { error } = await sb.from('corenull_stories').delete().eq('id', story_id);
        if (error) return _err(tid, 'DB_FAIL', error.message);
        result = { deleted: story_id };
        break;
      }

      // ════════════════════════════════════════════════════════════
      // CATEGORIES
      // ════════════════════════════════════════════════════════════

      case 'create-cat': {
        const { house_id, name, color, is_event, event_date } = payload;
        if (!house_id || !name) return _err(tid, 'MISSING_PARAMS', 'house_id, name 필수');

        const { data, error } = await sb.from('categories').insert({
          house_id, name, color, is_event: is_event ?? false,
          event_date: is_event ? event_date : null,
          created_at: new Date().toISOString(),
        }).select().single();
        if (error) return _err(tid, 'DB_FAIL', error.message);
        result = { category: data };
        break;
      }

      case 'update-cat': {
        const { id, ...patch } = payload;
        if (!id) return _err(tid, 'MISSING_PARAMS', 'id 필수');

        const { data, error } = await sb.from('categories')
          .update(patch).eq('id', id).select().single();
        if (error) return _err(tid, 'DB_FAIL', error.message);
        result = { category: data };
        break;
      }

      case 'delete-cat': {
        const { id } = payload;
        if (!id) return _err(tid, 'MISSING_PARAMS', 'id 필수');

        const { error } = await sb.from('categories').delete().eq('id', id);
        if (error) return _err(tid, 'DB_FAIL', error.message);
        result = { deleted: id };
        break;
      }

      // ════════════════════════════════════════════════════════════
      // SHARE
      // ════════════════════════════════════════════════════════════

      case 'create-invite': {
        const { post_id, owner_key } = payload;
        if (!post_id) return _err(tid, 'MISSING_PARAMS', 'post_id 필수');

        const invite_code = Array.from({ length: 8 }, () =>
          'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'[
            Math.floor(Math.random() * 62)
          ]
        ).join('');

        const { data, error } = await sb.from('corenull_invites').insert({
          post_id, invite_code, created_at: new Date().toISOString(),
        }).select().single();
        if (error) return _err(tid, 'DB_FAIL', error.message);
        result = { invite_code: data.invite_code };
        break;
      }

      // ════════════════════════════════════════════════════════════
      // UPLOAD — Cloudinary 서명 발급 (바이너리는 클라이언트가 직접 전송)
      // ════════════════════════════════════════════════════════════

      case 'sign-upload': {
        const { upload_preset, folder } = payload;
        const timestamp = Math.round(Date.now() / 1000);
        const signature = cloudinary.utils.api_sign_request(
          { timestamp, upload_preset: upload_preset ?? 'brainpool', folder: folder ?? 'uploads' },
          process.env.CLOUDINARY_API_SECRET,
        );
        result = {
          signature,
          timestamp,
          cloud_name: process.env.CLOUDINARY_CLOUD_NAME,
          api_key:    process.env.CLOUDINARY_API_KEY,
        };
        break;
      }

      // ════════════════════════════════════════════════════════════
      // LOCALE
      // ════════════════════════════════════════════════════════════

      case 'get-locale': {
        const { device_id } = payload;
        if (!device_id) return _err(tid, 'MISSING_PARAMS', 'device_id 필수');

        const { data } = await sb.from('core_users')
          .select('vi_locale').eq('device_id', device_id).single();
        result = { locale: data?.vi_locale ?? 'standard' };
        break;
      }

      case 'set-locale': {
        const { device_id, locale } = payload;
        if (!device_id || !locale) return _err(tid, 'MISSING_PARAMS', 'device_id, locale 필수');

        await sb.from('core_users').upsert(
          { device_id, vi_locale: locale, updated_at: new Date().toISOString() },
          { onConflict: 'device_id' }
        );
        result = { locale };
        break;
      }

      // ════════════════════════════════════════════════════════════
      // ONBOARDING
      // ════════════════════════════════════════════════════════════

      case 'get-interests': {
        const { data, error } = await sb.from('corenull_interests').select('*').order('sort_order');
        if (error) return _err(tid, 'DB_FAIL', error.message);
        result = { interests: data ?? [] };
        break;
      }

      case 'set-interests': {
        const { device_id, interest_ids } = payload;
        if (!device_id || !Array.isArray(interest_ids)) {
          return _err(tid, 'MISSING_PARAMS', 'device_id, interest_ids 필수');
        }
        const { error } = await sb.from('core_users').upsert(
          { device_id, interest_ids, updated_at: new Date().toISOString() },
          { onConflict: 'device_id' }
        );
        if (error) return _err(tid, 'DB_FAIL', error.message);
        result = { saved: true };
        break;
      }

      case 'join-house': {
        const { device_id, house_id } = payload;
        if (!device_id || !house_id) return _err(tid, 'MISSING_PARAMS', 'device_id, house_id 필수');

        const { error } = await sb.from('corenull_house_members').upsert(
          { device_id, house_id, joined_at: new Date().toISOString() },
          { onConflict: 'device_id,house_id' }
        );
        if (error) return _err(tid, 'DB_FAIL', error.message);
        result = { joined: true };
        break;
      }
    }

    return _res({ payload: result, traceId: tid, _error: null }, tid);

  } catch (e) {
    return _res({ _error: { code: 'LAYER_FAIL', message: e.message, retryable: true } }, tid, 500);
  }
}

// ── 헬퍼 ─────────────────────────────────────────────────────────
function _err(tid, code, message) {
  return _res({ _error: { code, message, retryable: false } }, tid);
}
function _res(data, traceId, status = 200) {
  return new Response(
    JSON.stringify({ ...data, traceId }),
    { status, headers: { 'Content-Type': 'application/json; charset=utf-8' } }
  );
}